{
  "manifest_version": 3,
  "name": "sobelpdf",
  "version": "1.0.0",
  "description": "Fast, private PDF reader: smooth zoom, dark mode, annotations, working links and an on-device read-aloud voice.",
  "minimum_chrome_version": "116",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "sobelpdf",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "src/ui/popup.html"
  },

  "options_ui": {
    "page": "src/ui/settings.html",
    "open_in_tab": true
  },

  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },

  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "contextMenus"
  ],

  "host_permissions": ["<all_urls>"],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "src/viewer/viewer.html",
        "assets/*",
        "pdfjs/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+P" },
      "description": "Open the sobelpdf popup"
    },
    "open-current-in-reader": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open the current PDF in sobelpdf"
    }
  }
}
